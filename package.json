{
  "name": "koi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "tokens": "pnpm --filter @koi/tokens build",
    "contrast": "pnpm --filter @koi/tokens contrast",
    "codegen": "pnpm tokens && panda codegen --clean",
    "dev": "pnpm codegen && pnpm --filter storybook dev",
    "dev:admin": "pnpm codegen && pnpm --filter admin dev",
    "build:storybook": "pnpm codegen && pnpm --filter storybook build",
    "deploy:storybook": "pnpm --filter storybook run deploy",
    "build": "pnpm codegen && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "shots": "pnpm --filter storybook shots",
    "lint": "biome lint . && biome format .",
    "lint:fix": "biome lint --write --unsafe . && biome format --write .",
    "check": "pnpm codegen && pnpm contrast && node scripts/check-raw-colors.mjs && node scripts/check-raw-sizes.mjs && node scripts/check-headless.mjs && node scripts/check-core.mjs && pnpm typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@pandacss/dev": "^2.1.2",
    "@pandacss/preset-base": "^2.1.2",
    "typescript": "^7.0.2"
  }
}
