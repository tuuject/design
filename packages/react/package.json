{
  "name": "@koi/react",
  "version": "0.1.0",
  "type": "module",
  "description": "Koi components for React web: Base UI for behavior, Panda CSS v2 for styling.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./styled-system/*": "./styled-system/*/index.js",
    "./alert": "./src/alert/Alert.tsx",
    "./avatar": "./src/avatar/Avatar.tsx",
    "./badge": "./src/badge/Badge.tsx",
    "./button": "./src/button/Button.tsx",
    "./card": "./src/card/Card.tsx",
    "./checkbox": "./src/checkbox/Checkbox.tsx",
    "./dialog": "./src/dialog/Dialog.tsx",
    "./divider": "./src/divider/Divider.tsx",
    "./field": "./src/field/Field.tsx",
    "./global-css": "./src/global-css.ts",
    "./icons": "./src/icons.tsx",
    "./input": "./src/input/Input.tsx",
    "./link": "./src/link/Link.tsx",
    "./pagination": "./src/pagination/Pagination.tsx",
    "./progress": "./src/progress/Progress.tsx",
    "./radio-group": "./src/radio-group/RadioGroup.tsx",
    "./recipes": "./src/recipes/index.ts",
    "./select": "./src/select/Select.tsx",
    "./select-panel": "./src/select/SelectPanel.tsx",
    "./shape": "./src/shape.tsx",
    "./skeleton": "./src/skeleton/Skeleton.tsx",
    "./spinner": "./src/spinner/Spinner.tsx",
    "./switch": "./src/switch/Switch.tsx",
    "./tabs": "./src/tabs/Tabs.tsx",
    "./tag": "./src/tag/Tag.tsx",
    "./textarea": "./src/textarea/Textarea.tsx",
    "./toast": "./src/toast/Toast.tsx",
    "./tooltip": "./src/tooltip/Tooltip.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@koi/tokens": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
