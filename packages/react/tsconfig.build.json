{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  // Recipes and globalCss are Panda config inputs, not component runtime: `panda lib` reads them from src,
  // and their types depend on Panda's config types that consumers never import.
  "exclude": ["src/global-css.ts", "src/recipes"]
}
