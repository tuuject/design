{
  "name": "@koi/tokens",
  "version": "0.1.0",
  "type": "module",
  "description": "Koi design tokens: one source (src/tokens.json), outputs for CSS, Panda CSS and React Native.",
  "exports": {
    "./tokens.json": "./src/tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./theme-init.js": "./dist/theme-init.js",
    "./fonts.css": "./fonts/fonts.css",
    "./panda": {
      "types": "./dist/panda-preset.d.ts",
      "default": "./dist/panda-preset.js"
    },
    "./native": "./dist/native.ts",
    "./dimensions": "./dist/dimensions.ts",
    "./palette": "./dist/palette.ts"
  },
  "files": [
    "src",
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "contrast": "node scripts/contrast.mjs",
    "typecheck": "node scripts/build.mjs && node scripts/contrast.mjs && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
