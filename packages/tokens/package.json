{
  "name": "@tuuject/koi-tokens",
  "version": "0.3.0",
  "type": "module",
  "description": "Koi design tokens: one source (src/tokens.json), outputs for CSS, Panda CSS and React Native.",
  "exports": {
    "./tokens.json": "./src/tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./theme-init.js": "./dist/theme-init.js",
    "./fonts.css": "./fonts/fonts.css",
    "./panda": {
      "types": "./dist/panda-preset.d.ts",
      "default": "./dist/panda-preset.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./dimensions": {
      "types": "./dist/dimensions.d.ts",
      "default": "./dist/dimensions.js"
    },
    "./palette": {
      "types": "./dist/palette.d.ts",
      "default": "./dist/palette.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "contrast": "node scripts/contrast.mjs",
    "typecheck": "pnpm build && tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuuject/design.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/tuuject/design#readme",
  "license": "MIT"
}
